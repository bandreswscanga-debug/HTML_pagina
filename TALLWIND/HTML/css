body {
  font-family: "Poppins", sans-serif;
  scroll-behavior: smooth;
}

.dark {
  background-color: #111827;
  color: #e5e7eb;
}

.dark header {
  background-color: #1f2937;
}

.dark .bg-white {
  background-color: #1f2937;
}

.dark input,
.dark textarea {
  background-color: #111827;
  color: #f9fafb;
  border-color: #374151;
}

.hero-slide {
  opacity: 1;
  transition: opacity 0.8s ease;
  background-size: cover;
  background-position: center;
}
